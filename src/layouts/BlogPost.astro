---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { SITE_AUTHOR, SITE_URL } from "../consts";

type Props = CollectionEntry<"blog">["data"] & { headings?: MarkdownHeading[] };

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
} = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
const showToc = h2s.length > 2;

const schema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		"@type": "Person",
		name: SITE_AUTHOR,
		url: SITE_URL,
	},
	url: Astro.url.toString(),
	...(heroImage && {
		image: new URL(heroImage.src, Astro.site ?? SITE_URL).toString(),
	}),
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.page-layout.has-toc {
				display: grid;
				grid-template-columns: 200px 1fr 200px;
				column-gap: 1.5rem;
				align-items: start;
			}
			.toc-sidebar {
				position: sticky;
				top: 5rem;
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
				scrollbar-width: none;
				padding-top: 1em;
			}
			.toc-sidebar::-webkit-scrollbar {
				display: none;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--text));
			}
			.prose :global(svg) {
				display: block;
				width: fit-content;
				margin: 0 auto;
			}
			.prose :global(svg + p) {
				text-align: center;
				font-size: 0.875em;
				color: rgb(var(--text-muted));
				margin-top: 0.25em;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--text-muted));
			}
			.last-updated-on {
				font-style: italic;
			}
			.toc-mobile {
				display: none;
				margin-bottom: 2em;
			}
			.scroll-progress {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 7px;
				background: var(--accent);
				transform-origin: left;
				transform: scaleX(0);
				animation: grow-progress auto linear;
				animation-timeline: scroll();
				z-index: 100;
			}
			@keyframes grow-progress {
				from { transform: scaleX(0); }
				to { transform: scaleX(1); }
			}
			@media (max-width: 1100px) {
				.toc-sidebar {
					display: none;
				}
				.page-layout.has-toc {
					display: block;
					padding: 0;
				}
				.toc-mobile {
					display: block;
				}
			}
		</style>
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>

	<body>
		<div class="scroll-progress" aria-hidden="true"></div>
		<Header />
		<main>
			<div class:list={['page-layout', { 'has-toc': showToc }]}>
				{showToc && (
					<aside class="toc-sidebar">
						<TableOfContents headings={h2s} />
					</aside>
				)}
				<article>
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" loading={"eager"} />}
					</div>
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
						</div>
						{showToc && (
						<div class="toc-mobile">
							<TableOfContents headings={h2s} />
						</div>
					)}
					<slot />
					</div>
				</article>
			</div>
		</main>
		<Footer />
	</body>
</html>
