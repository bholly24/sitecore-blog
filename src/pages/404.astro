---
import { Image } from "astro:assets";
import NotFoundImage from "../assets/not-found-spider.jpg";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<html lang="en">
	<head>
		<BaseHead title="404 — Page Not Found" description="This page does not exist." />
	</head>
	<body>
		<Header />
		<main>
			<h1>404</h1>
			<p>This page doesn't exist. <a href="/">Go home</a> to recombobulate.</p>
			<Image width={600} height={300} src={NotFoundImage} alt="" loading={"eager"} />
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 40vh;
		text-align: center;
	}
	h1 {
		font-size: 6rem;
		margin: 0;
		color: var(--accent);
		line-height: 1;
	}
</style>
